# ==========================================================
# VOLT: Virtual Orchestration of Load, Tariffs & Energy
# Environment Configuration Template
# ==========================================================

# Application Metadata
APP_ENV=development
APP_NAME="VOLT — Virtual Orchestration of Load, Tariffs & Energy"
APP_VERSION=0.1.0
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=volt_user
POSTGRES_PASSWORD=volt_secret_password
POSTGRES_DB=volt_db
DATABASE_URL=postgresql://volt_user:volt_secret_password@localhost:5432/volt_db

# Configuration Path (relative to project root or absolute)
CONFIG_DIR=configs
